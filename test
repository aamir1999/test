
/****** Object:  StoredProcedure [dbo].[SP_INSERT_PDLADATA]    Script Date: 30/10/2020 12:32:46 ******/

CREATE Procedure [dbo].[SP_INSERT_PDLADATA]
@RunId VARCHAR(37)
AS
BEGIN

SET NOCOUNT ON

BEGIN TRY
DECLARE @EffectiveTo DATETIME = '9999-12-31 23:59:59.000', @SourceSystem varchar(15) ='Crest',
 @Home varchar(10) = 'Home', @HomeCaps varchar(10) ='HOME', @Work varchar(10) ='Work', @WorkCaps varchar(10) = 'WORK',
 @Mobile  varchar(10) = 'Mobile', @MobileCaps varchar(10) = 'MOBILE', @RoleType varchar(10)= 'Member',@EmailSourceSystem varchar(50)='EDT';

 Declare @EmailValidationStatus nvarchar(max)

	--PartyId Generation

	update ImportContactDetailsFromCrest SET TYPE1 = @Home	WHERE RTRIM(LTRIM(TYPE1)) = @HomeCaps

	update ImportContactDetailsFromCrest SET TYPE1 = @Work WHERE RTRIM(LTRIM(TYPE1)) = @WorkCaps

	update ImportContactDetailsFromCrest SET TYPE1 = @Mobile WHERE RTRIM(LTRIM(TYPE1)) = @MobileCaps

	update ImportContactDetailsFromCrest SET TYPE2 = @Home	WHERE RTRIM(LTRIM(TYPE2)) = @HomeCaps

	update ImportContactDetailsFromCrest SET TYPE2 = @Work WHERE RTRIM(LTRIM(TYPE2)) = @WorkCaps

	update ImportContactDetailsFromCrest SET TYPE2 = @Mobile WHERE RTRIM(LTRIM(TYPE2)) = @MobileCaps

	update ImportContactDetailsFromCrest SET TYPE3 = @Home	WHERE RTRIM(LTRIM(TYPE3)) = @HomeCaps

	update ImportContactDetailsFromCrest SET TYPE3 = @Work WHERE RTRIM(LTRIM(TYPE3)) = @WorkCaps

	update ImportContactDetailsFromCrest SET TYPE3 = @Mobile WHERE RTRIM(LTRIM(TYPE3)) = @MobileCaps

    Declare @Record_InsertionList Table(uniqueId nvarchar(100))

	IF OBJECT_ID('tempdb..#PartyIdGeneration') IS NOT NULL DROP TABLE #PartyIdGeneration

	CREATE TABLE #PartyIdGeneration(PartyId uniqueIdentifier,Id uniqueIdentifier,RoleId uniqueIdentifier,uniqueId nvarchar(100))

	INSERT INTO #PartyIdGeneration(PartyId,Id,RoleId,uniqueId)
	SELECT NEWID() as PartyId,NEWID() as Id, NEWID() as RoleId, uniqueId
	FROM (SELECT  RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) as uniqueId
	FROM ImportContactDetailsFromCrest as temp
	LEFT JOIN PartyIdentifier as Party  on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = Party.[UniqueIdentifier]
	WHERE Id IS NULL
	GROUP BY temp.UNIQUE_IDENTIFIER) AS A


	INSERT INTO Party(Id,ContactDetailsLastCheckedDate,CreatedDate)
	select PartyId,GETDATE(),GETDATE() from #PartyIdGeneration

	INSERT INTO PartyIdentifier(Id,PartyId,SourceSystem,UniqueIdentifier)
	SELECT Id,PartyId,@SourceSystem,uniqueId FROM #PartyIdGeneration

	INSERT INTO Role(Id,PartyId,RoleType)
	SELECT RoleId,PartyId,@RoleType FROM #PartyIdGeneration

	-- INC7629945 Changes Start

	UPDATE TEMP
	SET @EmailValidationStatus = dbo.ValidateEmail(temp.EMAIL_ADDRESS),
	IsEmailValid = SUBSTRING(@EmailValidationStatus,1,1),
	ValidationComment = SUBSTRING(@EmailValidationStatus,3,(LEN(@EmailValidationStatus)))
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	WHERE RTRIM(LTRIM(temp.EMAIL_ADDRESS)) IS NOT NULL  AND RTRIM(LTRIM(temp.EMAIL_ADDRESS)) <>''
	AND ISNULL(IsEmailUpdated,0) = 0

	-- INC7629945 Changes End

	Insert into @Record_InsertionList
	Select temp.UNIQUE_IDENTIFIER
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Email ON PartyIdentifer.PartyId = Email.PartyId
	WHERE RTRIM(LTRIM(temp.EMAIL_ADDRESS)) IS NOT NULL  AND RTRIM(LTRIM(temp.EMAIL_ADDRESS)) <>''
	AND ISNULL(IsEmailUpdated,0) = 0 and ISNULL(IsEmailValid,0) = 1
	AND Email.PartyId IS NULL

	--INSERT INTO Email(Id,PartyId,EmailAddress,IsPrimary)
	--SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.EMAIL_ADDRESS)),1 as IsPrimary
	--FROM PartyIdentifier as PartyIdentifer
	--INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	--INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	--LEFT JOIN Email ON PartyIdentifer.PartyId = Email.PartyId -- Newly added to avoid duplicate record insertion
	--WHERE RTRIM(LTRIM(temp.EMAIL_ADDRESS)) IS NOT NULL  AND RTRIM(LTRIM(temp.EMAIL_ADDRESS)) <>''
	--AND ISNULL(IsEmailUpdated,0) = 0 and ISNULL(IsEmailValid,0) = 1 -- INC7629945 Changes Added a where clause for EmailValid Bit checking
	--AND Email.PartyId IS NULL -- Newly added to avoid duplicate record insertion

	INSERT INTO Email(Id,PartyId,EmailAddress,IsPrimary,LCEmailAddress,IsACSMarker,ExistingEmailSource,LCEmailSource,ExistingEmailUpdatedOn,LCEmailUpdatedOn)
	SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.EMAIL_ADDRESS)),0 as IsPrimary,RTRIM(LTRIM(temp.EMAIL_ADDRESS)), 0 as IsACSMarker,@EmailSourceSystem,@EmailSourceSystem,GETDATE(),GETDATE()
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Email ON PartyIdentifer.PartyId = Email.PartyId -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.EMAIL_ADDRESS)) IS NOT NULL  AND RTRIM(LTRIM(temp.EMAIL_ADDRESS)) <>''
	AND ISNULL(IsEmailUpdated,0) = 0 and ISNULL(IsEmailValid,0) = 1 -- INC7629945 Changes Added a where clause for EmailValid Bit checking
	AND Email.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	UPDATE TEMP
	SET IsEmailUpdated = 1
	FROM ImportContactDetailsFromCrest TEMP
	INNER JOIN @Record_InsertionList R ON TEMP.UNIQUE_IDENTIFIER = R.uniqueId

	Delete From @Record_InsertionList

	--added by shwetha
	--This is for update the email according to visco

	CREATE TABLE #Record_UpdateList(UNIQUE_IDENTIFIER nvarchar(100),Id nvarchar(100),EMAIL_ADDRESS nvarchar(100))


	Insert into #Record_UpdateList
	Select temp.UNIQUE_IDENTIFIER,Party.Id,temp.EMAIL_ADDRESS
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Email ON PartyIdentifer.PartyId = Email.PartyId
	WHERE RTRIM(LTRIM(temp.EMAIL_ADDRESS)) IS NOT NULL  AND RTRIM(LTRIM(temp.EMAIL_ADDRESS)) <>''
	AND ISNULL(IsEmailUpdated,0) = 0 and ISNULL(IsEmailValid,0) = 1
	AND Email.PartyId IS Not NULL

	Declare @uniqueId nvarchar(100)
	Declare @partyId nvarchar(100)
	Declare @emailAddress nvarchar(100)

	Declare DataCus CURSOR
	For Select UNIQUE_IDENTIFIER,Id,EMAIL_ADDRESS
	FROM #Record_UpdateList

	Open DataCus
	fetch next
	from DataCus into @uniqueId,@partyId,@emailAddress
	while @@FETCH_STATUS =0
	begin
	--select * from Email where  PartyId =@partyId and (LCEmailAddress=@emailAddress OR LCEmailAddress is null) and IsPrimary=0 and IsACSMarker=0
	 update Email set EmailAddress=@emailAddress,LCEmailAddress=@emailAddress,ExistingEmailSource=@EmailSourceSystem,LCEmailSource=@EmailSourceSystem,ExistingEmailUpdatedOn=GETDATE(),LCEmailUpdatedOn=GETDATE() where  PartyId =@partyId and (LCEmailAddress<>@emailAddress OR LCEmailAddress is null) and IsPrimary=0 and IsACSMarker=0
	 update Email set LCEmailAddress=@emailAddress,LCEmailSource=@EmailSourceSystem,LCEmailUpdatedOn=GETDATE() where  PartyId =@partyId and (LCEmailAddress<>@emailAddress OR LCEmailAddress is null) and IsPrimary=1 and IsACSMarker=0
	 update Email set LCEmailAddress=@emailAddress,LCEmailSource=@EmailSourceSystem,LCEmailUpdatedOn=GETDATE() where  PartyId =@partyId and (LCEmailAddress<>@emailAddress OR LCEmailAddress is null) and IsACSMarker=1 and IsPrimary=0
	 --DMND0033184-Add Email TO IPDB
	 update Email set LCEmailAddress=@emailAddress,LCEmailSource=@EmailSourceSystem,LCEmailUpdatedOn=GETDATE() where  PartyId =@partyId and (LCEmailAddress<>@emailAddress OR LCEmailAddress is null) and IsACSMarker=1 and IsPrimary=1
	fetch next from DataCus
	into @uniqueId,@partyId,@emailAddress
	end

	UPDATE TEMP
	SET IsEmailUpdated = 1
	FROM ImportContactDetailsFromCrest TEMP
	INNER JOIN #Record_UpdateList R ON TEMP.UNIQUE_IDENTIFIER = R.UNIQUE_IDENTIFIER

    Deallocate DataCus

	Delete From #Record_UpdateList

	Drop Table #Record_UpdateList

	--------------------
	Insert into @Record_InsertionList
	Select temp.UNIQUE_IDENTIFIER
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE1]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE1])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER1)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER1)) <>''
	AND ISNULL([IsType1Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	INSERT INTO Phone(Id,PartyId,Type,CountryCode,StdDiallingCode,Number,IsActive,EffectiveFrom,EffectiveTo)
	SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.TYPE1)),RTRIM(LTRIM(Replace(temp.COUNTRY_CODE1,' ',''))),RTRIM(LTRIM(Replace(temp.STD_DIALLING_CODE1,' ',''))),RTRIM(LTRIM(Replace(temp.NUMBER1,' ',''))),1 as Isactive,GETDATE(),@EffectiveTo
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE1]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE1])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER1)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER1)) <>''
	AND ISNULL([IsType1Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion

	UPDATE TEMP
	SET [IsType1Updated] = 1
	FROM ImportContactDetailsFromCrest TEMP
	INNER JOIN @Record_InsertionList R ON TEMP.UNIQUE_IDENTIFIER = R.uniqueId

	Delete From @Record_InsertionList

	Insert into @Record_InsertionList
	Select temp.UNIQUE_IDENTIFIER
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE2]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE2])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER2)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER2)) <>''
	AND ISNULL([IsType2Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	INSERT INTO Phone(Id,PartyId,Type,CountryCode,StdDiallingCode,Number,IsActive,EffectiveFrom,EffectiveTo)
	SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.TYPE2)),RTRIM(LTRIM(Replace(temp.COUNTRY_CODE2,' ',''))),RTRIM(LTRIM(Replace(temp.STD_DIALLING_CODE2,' ',''))),RTRIM(LTRIM(Replace(temp.NUMBER2,' ',''))),1 as Isactive,GETDATE(),@EffectiveTo
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE2]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE2])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER2)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER2)) <>''
	AND ISNULL([IsType2Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	UPDATE TEMP
	SET [IsType2Updated] = 1
	FROM ImportContactDetailsFromCrest TEMP
	INNER JOIN @Record_InsertionList R ON TEMP.UNIQUE_IDENTIFIER = R.uniqueId

	Delete From @Record_InsertionList

	Insert into @Record_InsertionList
	Select temp.UNIQUE_IDENTIFIER
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE3]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE3])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER3)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER3)) <>''
	AND ISNULL([IsType3Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	INSERT INTO Phone(Id,PartyId,Type,CountryCode,StdDiallingCode,Number,IsActive,EffectiveFrom,EffectiveTo)
	--SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.TYPE3)),RTRIM(LTRIM(temp.COUNTRY_CODE3)),RTRIM(LTRIM(temp.STD_DIALLING_CODE3)),RTRIM(LTRIM(temp.NUMBER3)),1 as Isactive,GETDATE(), @EffectiveTo -- INC7629945 Changes
	SELECT NEWID(),Party.Id,RTRIM(LTRIM(temp.TYPE3)),RTRIM(LTRIM(Replace(temp.COUNTRY_CODE3,' ',''))),RTRIM(LTRIM(Replace(temp.STD_DIALLING_CODE3,' ',''))),RTRIM(LTRIM(Replace(temp.NUMBER3,' ',''))),1 as Isactive,GETDATE(), @EffectiveTo
	FROM PartyIdentifier as PartyIdentifer
	INNER JOIN ImportContactDetailsFromCrest as temp on RTRIM(LTRIM(temp.UNIQUE_IDENTIFIER)) = PartyIdentifer.[UniqueIdentifier]
	INNER JOIN Party as Party on PartyIdentifer.PartyId = Party.Id
	LEFT JOIN Phone on Phone.PartyId = PartyIdentifer.PartyId and Phone.Type = RTRIM(LTRIM(temp.[TYPE3]))  -- Newly added to avoid duplicate record insertion
	WHERE RTRIM(LTRIM(temp.[TYPE3])) IS NOT NULL AND RTRIM(LTRIM(TEMP.NUMBER3)) IS NOT NULL  AND RTRIM(LTRIM(temp.NUMBER3)) <>''
	AND ISNULL([IsType3Updated],0) = 0
	AND Phone.PartyId IS NULL -- Newly added to avoid duplicate record insertion


	UPDATE TEMP
	SET [IsType3Updated] = 1
	FROM ImportContactDetailsFromCrest TEMP
	INNER JOIN @Record_InsertionList R ON TEMP.UNIQUE_IDENTIFIER = R.uniqueId

	Delete From @Record_InsertionList


	SELECT distinct IC.UNIQUE_IDENTIFIER,IC.ValidationComment FROM ImportContactDetailsFromCrest IC
	WHERE IC.IsEmailValid = 0 and IC.ValidationComment is not null

	INSERT INTO ImportContactDetailsFromCrest_Audit
	SELECT *,GETDATE() FROM ImportContactDetailsFromCrest

	DELETE FROM ImportContactDetailsFromCrest

	DROP TABLE #PartyIdGeneration
	END TRY
	BEGIN CATCH
		INSERT INTO [dbo].[Error]
		SELECT @RunId AS PipelineRunId, 0 AS CsvRowNumber,ERROR_NUMBER() AS ErrorNumber, ERROR_STATE() AS ErrorState,ERROR_SEVERITY() AS ErrorSeverity, ERROR_PROCEDURE() AS ErrorProcedure,
		ERROR_LINE() AS ErrorLine, ERROR_MESSAGE() AS ErrorMessage, getdate() AS CreatedDate;
	END CATCH
END
